{
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev --turbopack -p 3001",
    "dev:force": "bash scripts/start-dev.sh",
    "dev:3000": "bash scripts/dev-3000.sh",
    "kill:3000": "bash scripts/kill-port-3000.sh",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "db:setup": "npx tsx lib/db/setup.ts",
    "db:seed": "npx tsx lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:create": "docker cp lib/db/migrations/0000_manual_init.sql next_saas_starter_postgres:/tmp/init_schema.sql && docker exec -it next_saas_starter_postgres psql -U postgres -d postgres -f /tmp/init_schema.sql",
    "make-admin": "npx tsx scripts/make-admin.ts",
    "db:migrate:subscription-expiry": "psql $DATABASE_URL -f lib/db/migrations/add_subscription_expiry.sql",
    "db:migrate:subscription-limits": "psql $DATABASE_URL -f lib/db/migrations/add_subscription_limits.sql",
    "db:setup:prod": "npx tsx scripts/setup-production-db.ts",
    "db:reset:prod": "npx tsx scripts/reset-db.ts"
  },
